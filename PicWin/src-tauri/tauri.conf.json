{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pic",
  "version": "1.1.0",
  "identifier": "com.crl.picwin",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pic",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#000000",
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/models/*.onnx"],
    "fileAssociations": [
      {
        "name": "JPEG Image",
        "ext": ["jpg", "jpeg"],
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "name": "PNG Image",
        "ext": ["png"],
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "name": "GIF Image",
        "ext": ["gif"],
        "mimeType": "image/gif",
        "role": "Viewer"
      },
      {
        "name": "WebP Image",
        "ext": ["webp"],
        "mimeType": "image/webp",
        "role": "Viewer"
      },
      {
        "name": "HEIC Image",
        "ext": ["heic", "heif"],
        "mimeType": "image/heic",
        "role": "Viewer"
      },
      {
        "name": "TIFF Image",
        "ext": ["tif", "tiff"],
        "mimeType": "image/tiff",
        "role": "Viewer"
      },
      {
        "name": "BMP Image",
        "ext": ["bmp"],
        "mimeType": "image/bmp",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
